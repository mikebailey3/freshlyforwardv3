# Supabase project connection (Project Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for scripts/ (server-side, never expose to the client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Adzuna job search API (scripts/scrapeJobs.ts) -- free tier signup at
# https://developer.adzuna.com/
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
